{
  "name": "@veza/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "db:bootstrap:test": "node scripts/bootstrap-test-database.mjs",
    "db:bootstrap:production": "node scripts/bootstrap-production-database.mjs",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-fastify": "11.1.28",
    "@veza/authz": "workspace:*",
    "@veza/contracts": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "fastify": "5.6.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "jose": "6.2.3",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@types/node": "^24.0.15",
    "typescript": "6.0.2",
    "@types/pg": "8.20.0"
  },
  "type": "module"
}
