{
  "name": "veza-learning-cloud",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant education operating system for institutions.",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": ">=11.15.1"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm build:packages && turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "node scripts/qa/toolchain-contract.mjs && node scripts/qa/feature-inventory.mjs && node scripts/qa/crud-lifecycle.mjs && node scripts/qa/workflow-completeness.mjs && turbo run test",
    "test:toolchain": "node scripts/qa/toolchain-contract.mjs",
    "test:features": "node scripts/qa/feature-inventory.mjs",
    "test:crud": "node scripts/qa/crud-lifecycle.mjs",
    "test:workflows": "node scripts/qa/workflow-completeness.mjs",
    "test:integration": "pnpm --filter @veza/api test:integration",
    "test:ci": "turbo run lint typecheck test build",
    "test:visual:demo": "node scripts/visual/capture-demo-screens.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:packages": "pnpm --filter './packages/*' build"
  },
  "devDependencies": {
    "@types/node": "^24.0.15",
    "jose": "6.2.3",
    "pg": "8.22.0",
    "prettier": "^3.6.2",
    "turbo": "^2.10.7",
    "typescript": "6.0.2"
  }
}
