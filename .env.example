NODE_ENV=development
WEB_PORT=3000
CONTROL_PLANE_PORT=3001
API_PORT=4000
MIGRATION_DATABASE_URL=postgresql://veza_migrator:veza_migrator@localhost:5432/veza
DATABASE_URL=postgresql://veza_app:veza_app@localhost:5432/veza
CONTROL_PLANE_DATABASE_URL=postgresql://veza_control:veza_control@localhost:5432/veza
WORKER_DATABASE_URL=postgresql://veza_worker:veza_worker@localhost:5432/veza
REDIS_URL=redis://localhost:6379
OIDC_ISSUER_URL=https://identity.example.com/
OIDC_AUDIENCE=https://api.veza.example.com
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
OIDC_ACCOUNT_RECOVERY_URL=https://identity.example.com/account/recovery
OIDC_ACCOUNT_SUPPORT_URL=https://identity.example.com/help
PLATFORM_OPERATOR_REQUIRED_AMR=mfa
INVITATION_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key
INVITATION_TOKEN_KEY_VERSION=v1
DATABASE_POOL_MAX=12
DATABASE_STATEMENT_TIMEOUT_MS=15000
OUTBOX_DEGRADED_PENDING_EVENTS=500
OUTBOX_DEGRADED_AGE_SECONDS=300
OUTBOX_TRANSPORT=stdout
OUTBOX_BATCH_SIZE=10
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_LEASE_SECONDS=60
OUTBOX_MAXIMUM_ATTEMPTS=12
OUTBOX_RETRY_BASE_SECONDS=5
OUTBOX_RETRY_MAXIMUM_SECONDS=3600
EVENT_CONSUMER_BATCH_SIZE=25
SCHEDULER_BATCH_SIZE=10
SCHEDULER_INTERVAL_MS=10000
METRIC_REFRESH_INTERVAL_MS=300000
METRIC_REFRESH_BATCH_SIZE=25
EXPORT_BATCH_SIZE=5
EXPORT_LEASE_SECONDS=300
EXPORT_EXPIRY_SECONDS=86400
EXPORT_OBJECT_STORE_URL=http://localhost:4900/exports
EXPORT_OBJECT_STORE_TOKEN=replace-with-private-service-token
EXPORT_OBJECT_STORE_TIMEOUT_MS=60000
EXPORT_DOWNLOAD_MAXIMUM_BYTES=52428800
WORKER_INSTANCE_ID=local-worker-1
EVENTBRIDGE_EVENT_BUS_NAME=
EVENTBRIDGE_EVENT_SOURCE=veza.learning-cloud
EVENTBRIDGE_REQUEST_TIMEOUT_MS=15000
AWS_REGION=af-south-1
VEZA_DEMO_MODE=false
OIDC_AUTHORIZATION_URL=https://identity.example.com/authorize
OIDC_TOKEN_URL=https://identity.example.com/oauth/token
OIDC_WEB_CLIENT_ID=veza-web
OIDC_WEB_CLIENT_SECRET=
OIDC_WEB_REDIRECT_URI=http://localhost:3000/api/auth/callback
OIDC_WEB_SESSION_ENCRYPTION_KEY=replace-with-32-byte-base64-key
OIDC_CONTROL_PLANE_CLIENT_ID=veza-control-plane
OIDC_CONTROL_PLANE_CLIENT_SECRET=
OIDC_CONTROL_PLANE_REDIRECT_URI=http://localhost:3001/api/auth/callback
OIDC_CONTROL_PLANE_SESSION_ENCRYPTION_KEY=replace-with-a-different-32-byte-base64-key
VEZA_API_BASE_URL=http://localhost:4000
VEZA_ENVIRONMENT_LABEL=Local development
