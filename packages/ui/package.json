{
  "name": "@veza/ui",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./src/tokens.css",
    "./src/styles.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./styles.css": "./src/styles.css",
    "./catalogue": {
      "types": "./src/catalogue.ts",
      "import": "./dist/catalogue.js",
      "default": "./dist/catalogue.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:a11y": "node --test tests/accessibility-contracts.test.mjs",
    "test:visual": "node tests/visual-regression.test.mjs",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput"
  },
  "peerDependencies": {
    "react": ">=19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "react": "19.2.8",
    "typescript": "^7.0.2"
  }
}
