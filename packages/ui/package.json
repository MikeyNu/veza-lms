{
  "name": "@veza/ui",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./src/tokens.css",
    "./src/styles.css",
    "./src/system-v2.css",
    "./src/system.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./styles.css": "./src/styles.css",
    "./system.css": "./src/system.css",
    "./catalogue": {
      "types": "./src/catalogue.ts",
      "import": "./dist/catalogue.js",
      "default": "./dist/catalogue.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/component-contracts.test.mjs tests/accessibility-contracts.test.mjs tests/i18n-long-text.test.mjs tests/accent-contracts.test.mjs",
    "test:a11y": "node --test tests/accessibility-contracts.test.mjs tests/i18n-long-text.test.mjs tests/accent-contracts.test.mjs",
    "test:visual": "python tests/visual_regression.py",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "1.1.21",
    "@radix-ui/react-checkbox": "1.3.9",
    "@radix-ui/react-dialog": "1.1.21",
    "@radix-ui/react-dropdown-menu": "2.1.22",
    "@radix-ui/react-popover": "1.1.21",
    "@radix-ui/react-radio-group": "1.4.5",
    "@radix-ui/react-slot": "1.3.1",
    "@radix-ui/react-switch": "1.3.5",
    "@radix-ui/react-tabs": "1.1.19",
    "@radix-ui/react-toast": "1.2.21",
    "@radix-ui/react-tooltip": "1.2.14",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.27.0",
    "tailwind-merge": "3.6.0"
  },
  "peerDependencies": {
    "react": ">=19.2.0",
    "react-dom": ">=19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "6.0.2"
  }
}
